# ─────────────────────────────────────────────────────────────────────────────
# KYA — Know Your Agent
#
# Copy to `.env` and fill in. `pnpm deploy:local` writes this file for you with
# the local anvil defaults already populated, so the only things you ever add by
# hand are the three sponsor credentials at the bottom.
#
# Every integration is either LIVE (real sponsor infrastructure) or LOCAL
# (deterministic stand-in). Leaving a credential blank does NOT fake it: the API
# labels the surface `local:*`, the UI renders that label, and the registry
# refuses to treat a simulator-level World proof as a verified human.
# ─────────────────────────────────────────────────────────────────────────────

# ── chain ────────────────────────────────────────────────────────────────────
# 31337 = local anvil. 16602 = 0G Galileo testnet.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
PORT=5055

# ── keys (anvil defaults shown; these are PUBLIC test keys, never reuse) ─────
# attestor — signs EIP-712 humanhood attestations. Never sends transactions.
ATTESTOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# executor — the ONLY key allowed to settle action receipts.
EXECUTOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# owner — an agent owner, used by seed/demo flows. In production this is the
# user's own browser wallet.
OWNER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
# deployer / fallback
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── World ID ─────────────────────────────────────────────────────────────────
# Developer Portal → your app. `app_...` (v2 verify) or `rp_...` (v4 verify).
# UNSET  → local:attestor-signed. Proofs are recorded as ProofKind.WorldIdSimulator,
#          which PassportRegistry REFUSES for agent registration.
# SET    → live:world-cloud-verify. Real IDKit proofs verified against World, then
#          carried on-chain by an EIP-712 attestation.
# WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORLD_ACTION=kya-verify-owner
# Optional: exposed to the browser for IDKit. Same value as WORLD_APP_ID.
# VITE_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 0G Compute ───────────────────────────────────────────────────────────────
# UNSET  → local:deterministic-executor. Same input always yields the same
#          result, and every response is labeled so nothing renders as live 0G.
# SET    → live:0g-compute-router, with verify_tee requested per call. The TEE
#          attestation digest becomes Action.evidence on-chain.
# OG_COMPUTE_API_KEY=
OG_COMPUTE_BASE_URL=https://api.0g.ai/v1
OG_COMPUTE_MODEL=gpt-oss-120b
OG_VERIFY_TEE=true

# ── 0G Storage ───────────────────────────────────────────────────────────────
# Requires CHAIN_ID=16602. Falls back to local content-addressing otherwise —
# the digest is a keccak of the same canonical bytes either way, so logHead
# verification is identical in both modes.
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# OG_STORAGE_PRIVATE_KEY=

# ── ENS ──────────────────────────────────────────────────────────────────────
# The parent name KYA issues agent subnames under. Set at deploy time via
# PARENT_NAME, recorded in deployments/<chainId>.json. Point this name's ENS
# resolver at the deployed AgentNameRegistrar and every subname resolves through
# stock ENS tooling.
# PARENT_NAME=kya.eth

# ── web ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:5055
