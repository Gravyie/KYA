{
  "name": "mihari",
  "private": true,
  "version": "0.2.0",
  "description": "Wardrail: identity, permissions and audit for AI agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix apps/web",
    "start": "node apps/server/src/index.js",
    "test": "node --test --test-timeout=20000 apps/server/test/*.test.mjs",
    "owner:recover": "node scripts/recover-owner.mjs",
    "demo:mcp": "node packages/mcp/bin/mihari-mcp.js -- node examples/demo-mcp-server.mjs",
    "test:web": "node scripts/smoke-web.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-build",
    "test:worker": "npm run build:worker && WORKER_BUNDLE=.worker-build/index.js node scripts/smoke-worker.mjs",
    "deploy:worker": "wrangler deploy",
    "test:mobile": "node scripts/smoke-mobile.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.152.0",
    "miniflare": "5.20261019.2-beta"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
