{
  "name": "kya",
  "private": true,
  "version": "0.1.0",
  "description": "KYA — Know Your Agent. Onchain identity, authority and reputation for autonomous AI agents.",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "chain": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337 --silent",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "deploy:local": "bash scripts/deploy-local.sh",
    "abi": "node scripts/sync-abi.mjs",
    "seed": "pnpm --filter @kya/api seed",
    "api": "pnpm --filter @kya/api dev",
    "web": "pnpm --filter @kya/web dev",
    "verify": "node scripts/verify-e2e.mjs",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
