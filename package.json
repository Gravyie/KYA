{
  "name": "sigilant",
  "private": true,
  "version": "0.2.0",
  "description": "Sigilant: identity, permissions and audit for AI agents. Know your agent.",
  "license": "MIT",
  "type": "module",
  "engines": {"node": ">=20.12"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix apps/web",
    "start": "node apps/server/src/index.js",
    "test": "node --test --test-timeout=20000 apps/server/test/api.test.mjs",
    "owner:recover": "node scripts/recover-owner.mjs",
    "demo:mcp": "node packages/mcp/bin/sigilant-mcp.js -- node examples/demo-mcp-server.mjs"
  }
}
